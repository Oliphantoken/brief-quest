//---------------------------------------------------------------
// BRIEFS API

//GET Briefs (200)
GET {{BriefQuest_HostAddress}}/briefs/
Authorization: Bearer {{login.response.body.$.accessToken}}
Origin: http://localhost:3000

###

//GET briefs/1 (200)
GET {{BriefQuest_HostAddress}}/briefs/58
Authorization: Bearer {{login.response.body.$.accessToken}}

###

//GET briefs/999 (404 Missing)
GET {{BriefQuest_HostAddress}}/briefs/999
Authorization: Bearer {{login.response.body.$.accessToken}}

###

//GET a briefs/{id} with filtered quests (tier and status)
GET {{BriefQuest_HostAddress}}/briefs/4/quests?tier=Merit&status=Todo
Authorization: Bearer {{login.response.body.$.accessToken}}

###

//GET briefs/4/progress
GET {{BriefQuest_HostAddress}}/briefs/56/progress
Authorization: Bearer {{login.response.body.$.accessToken}}

###

//CREATE a new brief (201)
POST {{BriefQuest_HostAddress}}/briefs
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
    "Title": "NEW Game Design Brief",
    //"Text": "Create a game design document for your game where you describe your game idea, target audience, genre, player pesrpective, controls and gameplay mechanics."
    "Text": "Unit 4 Game Design. LO1: Understand how games are designed. LO2: Build a playable prototype. LO1 Pass: Describe the core mechanics of two games. LO1 Merit: Analyse how those mechanics motivate players. LO1 Distinction: Evaluate the mechanics using player research. LO2 Pass: Build a prototype with three levels. LO2 Merit: Test the prototype with five players. Submit a 1500-word design document and a 3-minute video by Friday 12 December."
}
###

//PATCH (Update) the Status of a quest in a brief with a new value (e.g. Done)
PATCH {{BriefQuest_HostAddress}}/briefs/58/quests/85
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{ "status": "Done" }

