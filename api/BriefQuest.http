@BriefQuest_HostAddress = http://localhost:5247
###

//GET Root
GET {{BriefQuest_HostAddress}}
###

// GET Config
GET {{BriefQuest_HostAddress}}/config-check
###

//GET Criterion (200)
GET {{BriefQuest_HostAddress}}/criterion
###

//---------------------------------------------------------------
//GEMINI requests DO NOT DOUBLE TAP - DO NOT RESEND OFTEN, YOU WILL USE FREE TOKENS

POST {{BriefQuest_HostAddress}}/briefs
Content-Type: application/json

{ "title": "Platformer brief", "text": "Create a 2D platformer prototype in Unity. Your submission must include a design document of 1500 words. To achieve a Merit, critically evaluate two similar games. To achieve a Distinction, justify your design decisions with reference to player research. Submit your project files and a 3-minute video walkthrough by Friday 12 December." }

###

POST {{BriefQuest_HostAddress}}/briefs/4/extract
###

//---------------------------------------------------------------
// BRIEFS API

//GET Briefs (200)
GET {{BriefQuest_HostAddress}}/briefs
###

//GET briefs/1 (200)
GET {{BriefQuest_HostAddress}}/briefs/4
###

//GET briefs/999 (404 Missing)
GET {{BriefQuest_HostAddress}}/briefs/999
###

//GET a briefs/{id} with filtered quests
GET {{BriefQuest_HostAddress}}/briefs/4/quests?tier=Merit&status=0
###

//CREATE a new brief (201)
POST {{BriefQuest_HostAddress}}/briefs
Content-Type: application/json

{
    "Title": "Game Development Brief",
    "Text": "Create a game design document for your game where you describe your game idea, target audience, genre, player pesrpective, controls and gameplay mechanics."
}
###

POST {{BriefQuest_HostAddress}}/extract-requirements
Content-Type: application/json

{ "text": "Create a game design document for your game where you describe your game idea, target audience, genre, player pesrpective, controls and gameplay mechanics." }
###
