@BriefQuest_HostAddress = http://localhost:5247
###

//GET Root
GET {{BriefQuest_HostAddress}}
###

// GET Config
GET {{BriefQuest_HostAddress}}/config-check
###

//GET Criterion (200)
GET {{BriefQuest_HostAddress}}/criterion
###

//---------------------------------------------------------------
//GEMINI requests DO NOT DOUBLE TAP - DO NOT RESEND OFTEN, YOU WILL USE FREE TOKENS

POST {{BriefQuest_HostAddress}}/briefs
Content-Type: application/json

//{ "title": "NEW Game Development brief", "text": "Create a 2D platformer prototype in Unity. Your submission must include a design document of 2000 words, describing the game idea, genre, target group, game mechanics and controls. To achieve a Merit, critically evaluate two similar games. To achieve a Distinction, justify your design decisions with reference to player research. Produce a 3-minute video walkthrough and submit it with your project files by Friday 12 December." }
{ "title": "NEW Game Audio Brief", "text": "Unit 4 Game Design. LO1: Understand how games are designed. LO2: Build a playable prototype. LO1 Pass: Describe the core mechanics of two games. LO1 Merit: Analyse how those mechanics motivate players. LO1 Distinction: Evaluate the mechanics using player research. LO2 Pass: Build a prototype with three levels. LO2 Merit: Test the prototype with five players. Submit a 1500-word design document and a 3-minute video by Friday 12 December." }
###

POST {{BriefQuest_HostAddress}}/briefs/26/extract
###

//---------------------------------------------------------------
// BRIEFS API

//GET Briefs (200)
GET {{BriefQuest_HostAddress}}/briefs
###

//GET briefs/1 (200)
GET {{BriefQuest_HostAddress}}/briefs/11
###

//GET briefs/999 (404 Missing)
GET {{BriefQuest_HostAddress}}/briefs/999
###

//GET a briefs/{id} with filtered quests (tier and status)
GET {{BriefQuest_HostAddress}}/briefs/4/quests?tier=Merit&status=Todo
###

//GET briefs/4/progress
GET {{BriefQuest_HostAddress}}/briefs/10/progress

###

//CREATE a new brief (201)
POST {{BriefQuest_HostAddress}}/briefs
Content-Type: application/json

{
    "Title": "NEW Game Design Brief",
    //"Text": "Create a game design document for your game where you describe your game idea, target audience, genre, player pesrpective, controls and gameplay mechanics."
    "Text": "Unit 4 Game Design. LO1: Understand how games are designed. LO2: Build a playable prototype. LO1 Pass: Describe the core mechanics of two games. LO1 Merit: Analyse how those mechanics motivate players. LO1 Distinction: Evaluate the mechanics using player research. LO2 Pass: Build a prototype with three levels. LO2 Merit: Test the prototype with five players. Submit a 1500-word design document and a 3-minute video by Friday 12 December."
}
###

//PATCH (Update) the Status of a quest in a brief with a new value (e.g. Done)
PATCH {{BriefQuest_HostAddress}}/briefs/4/quests/4
Content-Type: application/json

{ "status": "Done" }

###


------------------------------------------------
POST {{BriefQuest_HostAddress}}/extract-requirements
Content-Type: application/json

{ "text": "Create a game design document for your game where you describe your game idea, target audience, genre, player pesrpective, controls and gameplay mechanics." }
